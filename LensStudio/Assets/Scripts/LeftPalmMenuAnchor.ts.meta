  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Menu Target"}'
    - '// @input SceneObject menuObject {"hint":"The root SceneObject to anchor above the left palm."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Placement"}'
    - "// @input vec3 localOffset = {0,3,0} {\"hint\":\"Offset from the palm center, expressed in the palm's local basis (x=right, y=up, z=forward relative to the middle knuckle).\"}"
    - '// @input bool matchPalmRotation = true {"hint":"If true, the menu rotates with the palm. If false, the menu keeps its current world rotation (useful if you billboard it elsewhere)."}'
    - "// @input vec3 rotationOffsetDeg {\"hint\":\"Extra rotation (Euler angles in degrees) applied on top of the palm rotation. Interpreted in the palm's local frame: x=pitch around palm-right, y=yaw around palm-up, z=roll around palm-forward.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Facing Detection"}'
    - '// @input bool useBackOfHand {"hint":"If true, the menu opens when the BACK of the hand faces the camera (looking down at the dorsal side, e.g. handlebar grip pose). If false, it opens when the PALM faces the camera (classic palm-up menu)."}'
    - '// @input float openAngleDeg = 25 {"hint":"Hand-to-camera angle (degrees) at or below which the menu begins to open. Measured against the palm by default; against the back of the hand when useBackOfHand is enabled.", "widget":"slider", "min":0, "max":60, "step":1}'
    - '// @input float closeAngleDeg = 45 {"hint":"Hand-to-camera angle (degrees) at or above which the menu begins to close. Should be greater than openAngleDeg for hysteresis.", "widget":"slider", "min":0, "max":90, "step":1}'
    - '// @input float openDwellS = 0.15 {"hint":"How long (seconds) the palm must stay facing the camera before the menu opens. Prevents accidental glances.", "widget":"slider", "min":0, "max":1, "step":0.01}'
    - "// @input float closeDelayS = 0.1 {\"hint\":\"Grace period (seconds) during which brief tracking hiccups won't close the menu.\", \"widget\":\"slider\", \"min\":0, \"max\":1, \"step\":0.01}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Transition"}'
    - '// @input float fadeInS = 0.18 {"hint":"Seconds to fully fade/scale in.", "widget":"slider", "min":0.01, "max":1, "step":0.01}'
    - '// @input float fadeOutS = 0.15 {"hint":"Seconds to fully fade/scale out.", "widget":"slider", "min":0.01, "max":1, "step":0.01}'
    - '// @input bool useScale = true {"hint":"When enabled, the menu root is scaled between minScale and its authored scale to create a pop-in effect."}'
    - '// @input float minScale = 0.2 {"hint":"Starting scale (as a fraction of authored scale) at alpha 0. 1 disables the scale effect.", "widget":"slider", "min":0, "max":1, "step":0.01}'
