  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Bridge"}'
    - "// @input Component.ScriptComponent bridge {\"hint\":\"The SpecsRiderBridge ScriptComponent. Subscribes to the 'nowPlaying' topic and sends 'media/*' requests.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Modules"}'
    - '// @input Asset.InternetModule internetModule {"hint":"Drag the Internet Module asset from the Asset Browser here. Required to mint the spectacleskit:// album-art resource."}'
    - '// @input Asset.RemoteMediaModule remoteMediaModule {"hint":"Drag the Remote Media Module asset from the Asset Browser here. Used to decode the album-art JPEG bytes streamed from the iOS app."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Transport buttons"}'
    - "// @input AssignableType pausePlayButton {\"hint\":\"RectangleButton (SpectaclesUIKit) the user taps to toggle play/pause. Sends 'media/toggle'.\"}"
    - "// @input SceneObject playIcon {\"hint\":\"Child SceneObject of the pause/play button showing the 'play' icon. Enabled while paused.\"}"
    - "// @input SceneObject pauseIcon {\"hint\":\"Child SceneObject of the pause/play button showing the 'pause' icon. Enabled while playing.\"}"
    - "// @input AssignableType_1 skipButton {\"hint\":\"RectangleButton (SpectaclesUIKit) the user taps to skip to the next track. Sends 'media/next'.\"}"
    - "// @input AssignableType_2 prevButton {\"hint\":\"Optional RectangleButton (SpectaclesUIKit) for previous track. Sends 'media/previous' if assigned.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Now Playing UI"}'
    - '// @input Component.Image albumArtImage {"hint":"Image component receiving album art. Its mainPass.baseTex is overwritten when the bridged artwork version changes."}'
    - '// @input Component.Text titleText {"hint":"Text component showing the current track title."}'
    - '// @input Component.Text artistText {"hint":"Text component showing the current track artist(s)."}'
    - '// @input Component.Text albumText {"hint":"Text component showing the current track album."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Behaviour"}'
    - '// @input bool verbose {"hint":"If true, prints verbose now-playing updates to the log."}'
    - '// @input string placeholderTitle {"hint":"Optional fallback text used when the bridge has not yet supplied a value (e.g. while disconnected)."}'
