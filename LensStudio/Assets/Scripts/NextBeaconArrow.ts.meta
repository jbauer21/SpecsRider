  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Arrow"}'
    - '// @input SceneObject arrowObject {"hint":"The cone / arrow SceneObject whose world rotation will be driven to point at the next beacon."}'
    - "// @input vec3 tipDirection = {0,1,0} {\"hint\":\"The direction the cone's tip points along in the arrow's own local space. Default (0, 1, 0) matches Lens Studio's primitive 'Cone' which points along local +Y. Use (0, 0, -1) if your arrow points along Lens Studio forward (-Z).\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Route"}'
    - "// @input Component.ScriptComponent routeBeaconController {\"hint\":\"The MobileRouteController driving the beacons. Its next unvisited waypoint is the arrow's target.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Aiming"}'
    - '// @input bool horizontalOnly = true {"hint":"If true, the arrow only yaws (rotates around world Y) and stays level, so it looks like a compass needle. If false, the arrow also pitches up/down toward the beacon."}'
    - '// @input float smoothing = 0.25 {"hint":"Rotation smoothing per frame. 1 = snap instantly, lower = smoother follow. Expressed as the fraction of the remaining angle covered each frame at 60 FPS.", "widget":"slider", "min":0, "max":1, "step":0.01}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Visibility"}'
    - "// @input bool hideWhenNoTarget {\"hint\":\"If true, the arrow is hidden whenever there is no valid next beacon (route not built yet, no GPS fix, or route complete). Leave false while developing in preview (there's no GPS there), and turn on for production builds if you want the cone to disappear on arrival.\"}"
    - '// @input float minTargetDistanceCm = 1 {"hint":"Minimum distance (world centimetres) from arrow to target before rotation is updated. Prevents jitter when the target is effectively on top of the arrow."}'
    - '// @input bool verbose {"hint":"If true, logs a one-line status every ~1s showing whether the arrow has a target and its current bearing."}'
